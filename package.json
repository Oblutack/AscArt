{
  "name": "asc-art",
  "version": "1.1.0",
  "description": "Cyberpunk Desktop ASCII Generator",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "vite",
    "react-build": "vite build",
    "electron-start": "electron .",
    "start": "concurrently -k \"npm:react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "npm run test:electron && npm run test:ui",
    "test:electron": "node --test electron/export.test.js",
    "test:ui": "vitest run",
    "build:engine": "node scripts/build-engine.js",
    "build": "npm run react-build && npm run build:engine && npm run dist"
  },
  "author": "Oblutack",
  "build": {
    "appId": "com.ascart.app",
    "productName": "AscArt",
    "extends": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "build/**/*",
      "electron/**/*",
      "assets/icon.png",
      "!electron/**/*.test.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "python/dist",
        "to": "python",
        "filter": [
          "engine",
          "engine.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "7z"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
