{
  "name": "asc-art",
  "version": "1.1.0",
  "description": "Cyberpunk Desktop ASCII Generator",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test electron/export.test.js",
    "build:engine": "cd python && pyinstaller engine.spec --clean --noconfirm",
    "build": "npm run react-build && npm run build:engine && npm run dist"
  },
  "author": "Oblutack",
  "build": {
    "appId": "com.ascart.app",
    "productName": "AscArt",
    "extends": null,
    "files": [
      "build/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "!build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "7z"
    },
    "extraResources": [
      {
        "from": "python/dist",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
