{
  "name": "asc-art",
  "version": "1.1.0",
  "description": "Cyberpunk Desktop ASCII Generator",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test electron/export.test.js",
    "build:engine": "node scripts/build-engine.js",
    "build": "npm run react-build && npm run build:engine && npm run dist"
  },
  "author": "Oblutack",
  "build": {
    "appId": "com.ascart.app",
    "productName": "AscArt",
    "extends": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "build/**/*",
      "electron/**/*",
      "assets/icon.png",
      "!electron/**/*.test.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "python/dist",
        "to": "python",
        "filter": [
          "engine",
          "engine.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "7z"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
